# Bot token from Discord Developer Portal -> Bot -> Reset Token
DISCORD_TOKEN=

# Application ID from Discord Developer Portal -> General Information -> Application ID
CLIENT_ID=

# Your server's ID (right-click the server icon -> Copy Server ID, needs Developer Mode on).
# Commands deploy instantly to this one guild instead of waiting up to an hour for global
# propagation. Since this bot only ever runs in one server, keep this set even in production.
GUILD_ID=

# Where the SQLite database file lives. On Railway, mount the persistent volume at /app/data
# and leave this pointing into it so the DB survives redeploys.
DATABASE_PATH=./data/pokebot.sqlite
